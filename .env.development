# Development Environment Variables for Markdown Previewer

# General Application Settings
# This port is used by Create React App's development server.
PORT=3000

# Base URL for the main API gateway or backend service, if applicable.
# While this app is primarily client-side, it might interact with a backend
# for user authentication, saving preferences, or fetching initial data.
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# Feature Flags for Development
# Set to 'true' to enable experimental AI features in development.
# For example, integration with the AI-Powered Content Summarizer.
REACT_APP_ENABLE_AI_FEATURES=true

# Set to 'true' to enable collaboration features in development.
# This might involve connecting to a WebSocket server from the Collaborative Code Editor.
REACT_APP_ENABLE_COLLABORATION=false

# Default content for the Markdown Editor when the app loads in development.
# This helps developers quickly test rendering without typing.
REACT_APP_DEFAULT_MARKDOWN_CONTENT="""
# Welcome to the Markdown Previewer!

This is a live markdown editor built with React.
Type your markdown on the left, and see the HTML rendered on the right in real-time.

## Features
*   **Real-time Preview**: See your changes instantly.
*   **Rich Formatting**: Supports headings, lists, links, images, code blocks, and more.
*   **Cross-Project Integration**:
    *   Potentially integrates with the **AI-Powered Content Summarizer** for quick summaries.
    *   Content could be published to the **Full-Stack Blog Platform**.
    *   Future plans for real-time collaboration via the **Collaborative Code Editor**.

### Example Code Block
```javascript
function helloWorld() {
  console.log('Hello, Markdown!');
}
helloWorld();
```

### Links
[Visit Google](https://www.google.com)

### Lists
*   Item 1
*   Item 2
    *   Sub-item A
    *   Sub-item B
1.  Numbered Item 1
2.  Numbered Item 2

### Images
![React Logo](https://upload.wikimedia.org/wikipedia/commons/a/a7/React-icon.svg)

---

Enjoy editing!
"""

# Cross-Project Service Endpoints (Simulating Microservice Architecture)
# These URLs point to other services within our ecosystem.

# API endpoint for the AI-Powered Content Summarizer service.
# Used to send markdown content for summarization.
REACT_APP_AI_SUMMARIZER_API_URL=http://localhost:5001/summarize

# API endpoint for the Full-Stack Blog Platform.
# Markdown content could be saved or fetched from this platform.
REACT_APP_BLOG_PLATFORM_API_URL=http://localhost:4000/api/posts

# WebSocket URL for the Collaborative Code Editor service.
# Used for real-time collaborative editing features.
REACT_APP_COLLAB_EDITOR_WS_URL=ws://localhost:6000/collab

# API endpoint for the E-commerce Storefront (example of another service).
# Not directly used by the Markdown Previewer, but demonstrates interconnectedness.
REACT_APP_ECOMMERCE_API_URL=http://localhost:3001/api/products

# API endpoint for the Recipe & Meal Planner (another example).
REACT_APP_RECIPE_PLANNER_API_URL=http://localhost:3002/api/recipes