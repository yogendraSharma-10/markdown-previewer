# Node modules
node_modules/
.pnp/
.pnp.js

# build output
build/
dist/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment variables
# These files are intended to be kept out of version control for security reasons,
# as they often contain sensitive API keys or configuration specific to a local environment.
# The project explicitly lists .env.development and .env.production, which should be ignored.
.env
.env.local
.env.development
.env.production
.env.test.local
.env.development.local
.env.production.local

# Dependency lock files (except package-lock.json which is explicitly tracked)
yarn.lock

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
*.stackdump

# Editor directories and files
.vscode/        # VSCode settings (if not shared)
.idea/          # IntelliJ IDEA settings
*.sublime-project
*.sublime-workspace
*.swp           # Vim swap files
*.swo           # Vim swap files

# Test coverage
coverage/

# Miscellaneous
.cache/
*.tgz
*.zip
*.rar
*.7z