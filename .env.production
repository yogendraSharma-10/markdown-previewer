# .env.production
# This file contains environment variables specific to the production build of the Markdown Previewer application.
# These variables are typically injected at build time and are publicly accessible in the client-side code.
# DO NOT store sensitive API keys or secrets here that should not be exposed to the client.

# Standard React environment variable for production builds.
NODE_ENV=production

# Base URL for the main API backend, if any.
# In a microservice architecture, this might be an API Gateway or a specific service endpoint.
REACT_APP_API_BASE_URL=https://api.markdownpreviewer.com/v1

# --- Feature Toggles & Configuration ---
# Example: Enable or disable certain features in production.
REACT_APP_ENABLE_ADVANCED_FEATURES=true
REACT_APP_MAX_PREVIEW_LENGTH=10000

# --- Analytics & Monitoring ---
# Google Analytics Tracking ID for production. Replace with your actual ID.
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-1

# --- Microservice Integration (Cross-Project Context) ---
# URLs for interacting with other services in the ecosystem.

# API endpoint for the AI-Powered Content Summarizer service.
# The Markdown Previewer could send markdown content to this service for summarization.
REACT_APP_CONTENT_SUMMARIZER_SERVICE_URL=https://api.summarizer.com/v1/summarize

# API endpoint for the Full-Stack Blog Platform.
# The Markdown Previewer might offer a "Publish to Blog" feature, sending markdown content.
REACT_APP_BLOG_PLATFORM_API_URL=https://api.blogplatform.com/v1/posts

# API endpoint for a dedicated Markdown Parsing Service (if offloaded from client-side).
# This could be used for more complex parsing, validation, or server-side rendering in a microservice setup.
REACT_APP_MARKDOWN_PARSER_SERVICE_URL=https://api.markdownparser.com/v1/parse

# Example: URL for the Collaborative Code Editor, if the previewer could link to it or embed content.
REACT_APP_COLLABORATIVE_EDITOR_URL=https://editor.collaborative.com

# Example: URL for the E-commerce Storefront, if there's any integration (e.g., product descriptions in markdown).
REACT_APP_ECOMMERCE_STOREFRONT_URL=https://www.ecommerce.com

# Example: URL for the Recipe & Meal Planner, if markdown could be used for recipes or meal descriptions.
REACT_APP_RECIPE_PLANNER_URL=https://www.recipeplanner.com